<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '9.0.100'))">$(TargetFrameworks);net9.0;net10.0</TargetFrameworks>
    <RootNamespace>VietQR.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- NuGet Package Metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>VietQR.Core</PackageId>
    <Title>VietQR.Core - Thư viện tạo và đọc mã VietQR (.NET / C#)</Title>
    <Version>1.0.2</Version>
    <Authors>Hien Dev</Authors>
    <Company>Ngochiendev</Company>
    <Description>Thư viện C# (.NET) hỗ trợ tạo chuỗi, đọc mã QR và render ảnh thẻ thanh toán VietQR theo chuẩn NAPAS247 / EMVCo, tích hợp sẵn danh mục ngân hàng Việt Nam.</Description>
    <PackageTags>vietqr;vietqr-core;napas247;emvco;qrcode;payment;banking;csharp;dotnet;skiasharp</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Ngochiendev/vietqr-core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Ngochiendev/vietqr-core</PackageProjectUrl>
    <PackageIcon>vietqr_icon.png</PackageIcon>
    <PackageReleaseNotes>See https://github.com/Ngochiendev/vietqr-core/releases for the latest release notes.</PackageReleaseNotes>

    <!-- SourceLink, Symbols & Deterministic Builds -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <Import Project="$(MSBuildProjectDirectory)\..\..\version.props" Condition="Exists('$(MSBuildProjectDirectory)\..\..\version.props')" />

  <ItemGroup>
    <PackageReference Include="DotNet.ReproducibleBuilds" Version="2.0.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="vietqr_core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="Resources\vietqr_icon.png" Pack="true" PackagePath="\" />
    <!-- Ảnh README dùng đường dẫn tương đối: pack cùng cấu trúc thư mục để NuGet.org render đúng -->
    <None Include="Resources\vietqr.png" Pack="true" PackagePath="src/VietQR.Core/Resources\" />
    <None Include="Resources\napas247.png" Pack="true" PackagePath="src/VietQR.Core/Resources\" />
    <None Include="Resources\examples\*.png" Pack="true" PackagePath="Resources/examples\" />
    <None Include="..\..\docs\image\*.png" Pack="true" PackagePath="docs\image\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\vietqr.png" LogicalName="VietQR.Core.Resources.vietqr.png" />
    <EmbeddedResource Include="Resources\vietqr_icon.png" LogicalName="VietQR.Core.Resources.vietqr_icon.png" />
    <EmbeddedResource Include="Resources\napas247.png" LogicalName="VietQR.Core.Resources.napas247.png" />
    <EmbeddedResource Include="Resources\banks.json" LogicalName="VietQR.Core.Resources.banks.json" />
    <EmbeddedResource Include="Resources\logos\*.png" LogicalName="VietQR.Core.Resources.logos.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\fonts\*.ttf" LogicalName="VietQR.Core.Resources.fonts.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
